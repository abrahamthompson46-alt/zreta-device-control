# Copy to .env for local development. Never commit real secrets.

DJANGO_SETTINGS_MODULE=zreta_control.settings.local
DJANGO_SECRET_KEY=replace-with-a-long-random-value
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# HMAC pepper for hashing enrollment secrets (not the enrollment secret itself)
ENROLLMENT_TOKEN_PEPPER=replace-with-a-long-random-value
ENROLLMENT_SESSION_TTL_MINUTES=30
PUBLIC_API_BASE_URL=http://127.0.0.1:8000

# Location (Phase 3)
LOCATION_RETENTION_DAYS=30
LOCATION_MAX_BATCH=20
LOCATION_MAX_PER_HOUR=12

# Public base URL embedded in enrollment QR payloads (no credentials)
DEVICE_ACCESS_TOKEN_TTL_SECONDS=900
DEVICE_ASSERTION_TTL_SECONDS=120
DEVICE_JWT_AUDIENCE=zreta-device
DEVICE_JWT_ISSUER=zreta-control

# PostgreSQL (local Docker)
POSTGRES_DB=zreta_control
POSTGRES_USER=zreta
POSTGRES_PASSWORD=replace-with-local-only-password
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# Set true only behind HTTPS
DJANGO_SESSION_COOKIE_SECURE=false
# Set true only if local Postgres/Docker is unavailable. Prefer PostgreSQL.
ZRETA_TEST_SQLITE=false
ZRETA_USE_SQLITE=false
